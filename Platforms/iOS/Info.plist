<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Textes affichés à l'utilisateur lors des demandes d'autorisation -->
	<key>NSCameraUsageDescription</key>
	<string>VoixDuQuartier a besoin de l'appareil photo pour joindre une photo à votre signalement.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VoixDuQuartier a besoin de vos photos pour joindre une image à votre signalement.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VoixDuQuartier utilise votre position pour localiser le problème signalé.</string>
</dict>
</plist>
