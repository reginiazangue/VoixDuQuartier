<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="VoixDuQuartier.Controls.StatusPill"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border x:Name="Pill" Padding="10,3" StrokeThickness="0" HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Label x:Name="PillLabel" FontSize="11" FontFamily="InterBold" TextColor="#121212" />
    </Border>
</ContentView>
