<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="VoixDuQuartier.Controls.ChipView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border Style="{StaticResource ChipBorder}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Command, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Green}" />
                <Setter Property="Stroke" Value="{StaticResource GreenBrush}" />
            </DataTrigger>
        </Border.Triggers>

        <Label Text="{Binding Text, Source={x:Reference Root}}" FontSize="13" FontFamily="InterBold">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsSelected, Source={x:Reference Root}}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource OnGreen}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
