<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VoixDuQuartier.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:VoixDuQuartier.Controls"
    Shell.TabBarIsVisible="False">

    <!-- 01 · Écran de démarrage -->
    <Grid RowDefinitions="*,Auto,*" Padding="24">
        <VerticalStackLayout Grid.Row="1" Spacing="14" HorizontalOptions="Center">
            <controls:AppLogo Scale="1.3" Margin="0,0,0,14" />
            <Label Text="VoixDuQuartier" Style="{StaticResource Title}" FontSize="30" HorizontalTextAlignment="Center" />
            <Label Text="Signalez. Soutenez. Suivez." Style="{StaticResource Muted}" FontSize="14" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" VerticalOptions="End" Spacing="12" Margin="0,0,0,16">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Green}" />
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Green}" />
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Green}" />
            </HorizontalStackLayout>
            <Label Text="v1.0" Style="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
