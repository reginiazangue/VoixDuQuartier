<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VoixDuQuartier.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:VoixDuQuartier.Controls"
    Shell.TabBarIsVisible="False">

    <!-- 03 · Inscription (nom, e-mail, quartier, mot de passe) -->
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="14">
            <controls:AppLogo />
            <Label Text="Inscription" Style="{StaticResource Title}" HorizontalTextAlignment="Center" Margin="0,0,0,8" />

            <controls:FormField Label="Nom complet" Placeholder="Nom complet"
                                Text="{Binding FullName, Mode=TwoWay}" Error="{Binding FullNameError}" />

            <controls:FormField Label="E-mail" Placeholder="votreemail@gmail.com" Keyboard="Email"
                                Text="{Binding Email, Mode=TwoWay}" Error="{Binding EmailError}" />

            <controls:FormField Label="Quartier" Placeholder="Exemple : PK17"
                                Text="{Binding Neighborhood, Mode=TwoWay}" Error="{Binding NeighborhoodError}" />

            <controls:FormField Label="Mot de passe" Placeholder="8 caractères minimum" IsPassword="True"
                                Text="{Binding Password, Mode=TwoWay}" Error="{Binding PasswordError}" />

            <controls:FormField Label="Confirmer le mot de passe" Placeholder="••••••••" IsPassword="True"
                                Text="{Binding ConfirmPassword, Mode=TwoWay}" Error="{Binding ConfirmError}" />

            <Button
                Text="Créer un compte"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding RegisterCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,12,0,0">
                <Label Text="Déjà un compte ?" Style="{StaticResource Muted}" />
                <Label Text="Se connecter" Style="{StaticResource LinkLabel}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
