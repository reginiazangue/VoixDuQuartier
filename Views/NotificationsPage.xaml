<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VoixDuQuartier.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Alertes">

    <!-- 09 · Notifications -->
    <Grid RowDefinitions="Auto,*" Padding="24,0">
        <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,12">
            <Label Text="Notifications" Style="{StaticResource Title}" />
            <Label Grid.Column="1" Text="Tout marquer comme lu" Style="{StaticResource LinkLabel}" FontSize="12" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MarkAllReadCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Start" Margin="0,5,0,0"
                                     Color="{StaticResource Green}" Opacity="{Binding IsUnread, Converter={StaticResource ReachedOpacity}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="14" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Muted}" FontSize="11" VerticalOptions="Start" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- État « vide » -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Spacing="8">
            <Label Text="🔕" FontSize="44" HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyTitle}" Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyMessage}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
