<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette VoixDuQuartier (identique aux maquettes Figma) -->
    <Color x:Key="Green">#2E9E6B</Color>
    <Color x:Key="Orange">#F2A93B</Color>
    <Color x:Key="Red">#E5484D</Color>
    <Color x:Key="GrayStatus">#8A8A8A</Color>
    <Color x:Key="OnGreen">#121212</Color>

    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}" />

    <!-- Thème sombre (par défaut) -->
    <Color x:Key="DarkBg">#121212</Color>
    <Color x:Key="DarkSurface">#1E1E1E</Color>
    <Color x:Key="DarkBorder">#3A3A3A</Color>
    <Color x:Key="DarkThumb">#2A2A2A</Color>
    <Color x:Key="DarkText">#F5F5F5</Color>
    <Color x:Key="DarkMuted">#8A8A8A</Color>

    <!-- Thème clair (activé par l'interrupteur « Mode sombre » du profil) -->
    <Color x:Key="LightBg">#F6F6F4</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightBorder">#DADADA</Color>
    <Color x:Key="LightThumb">#E8E8E8</Color>
    <Color x:Key="LightText">#121212</Color>
    <Color x:Key="LightMuted">#6B6B6B</Color>
</ResourceDictionary>
